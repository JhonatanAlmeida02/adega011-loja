# Copie para .env.local e preencha. NUNCA faça commit do .env.local.
# Sem as variáveis do Supabase, a loja abre em MODO DEMONSTRAÇÃO (dados de exemplo, sem admin).

# Supabase > Project Settings > API (ou "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "anon" (legada) ou "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta: "service_role" (legada) ou "secret" (sb_secret_...)
# Usada SOMENTE pelos scripts locais `npm run seed` e `npm run criar-admin`.
# Não é necessária na Vercel/Netlify.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
