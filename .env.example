# Copie para .env.local e preencha. NUNCA faça commit do .env.local.
# Sem as variáveis do Supabase, a loja abre em MODO DEMONSTRAÇÃO (dados de exemplo, sem admin).

# Supabase > Project Settings > API (ou "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "anon" (legada) ou "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta: "service_role" (legada) ou "secret" (sb_secret_...)
# Usada SOMENTE pelos scripts locais `npm run seed` e `npm run criar-admin`.
# Não é necessária na Vercel/Netlify.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# WMS (/wms). Veja docs/wms/configuracao.md. Nenhum valor real aqui.
# ---------------------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:3000
# Chave publicável nova (opcional; se vazia usa NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SOMENTE SERVIDOR: convite de usuários do WMS
SUPABASE_SECRET_KEY=
# Conexão Postgres do backend e do worker (pooler em modo transação)
DATABASE_URL=
# OAuth do aplicativo privado na Olist (somente servidor/worker)
OLIST_CLIENT_ID=
OLIST_CLIENT_SECRET=
OLIST_REDIRECT_URI=http://localhost:3000/api/integrations/olist/callback
OLIST_API_BASE_URL=https://api.tiny.com.br/public-api/v3
OLIST_ADAPTER=mock
# Escrita real no ERP: desligada até homologar a política de lançamento
OLIST_WRITE_ENABLED=false
OLIST_OAUTH_PKCE=false
OLIST_RATE_READ_PER_MIN=30
OLIST_RATE_WRITE_PER_MIN=10
# AES-256 dos tokens (32 bytes em base64). Fora do banco e do Git.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_VERSION=1
INTEGRATION_ENCRYPTION_KEY_PREVIOUS=
WMS_WORKER_INTERVAL_MS=5000
LOG_LEVEL=info
